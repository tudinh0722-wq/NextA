<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/nexta_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_status_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="NEXT"
                android:textColor="@color/nexta_widget_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_location_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="A203"
                android:textColor="@color/nexta_widget_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Lập trình Android"
            android:textColor="@color/nexta_widget_on_container"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_time_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="08:00 – 10:00"
            android:textColor="@color/nexta_widget_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_countdown_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="Bắt đầu sau 42m"
            android:textColor="@color/nexta_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_note_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ghi chú"
            android:textColor="@color/nexta_widget_muted"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="7dp"
        android:background="@color/nexta_widget_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_status_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="NEXT"
                android:textColor="@color/nexta_widget_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_location_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="B402"
                android:textColor="@color/nexta_widget_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Cơ sở dữ liệu"
            android:textColor="@color/nexta_widget_on_container"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_time_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="10:15 – 12:00"
            android:textColor="@color/nexta_widget_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_countdown_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="Bắt đầu sau 2h 15m"
            android:textColor="@color/nexta_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_note_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ghi chú"
            android:textColor="@color/nexta_widget_muted"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
